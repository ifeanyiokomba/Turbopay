# ============================================================
# TurboPay SDK — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Security (REQUIRED) ──────────────────────────────────────
# JWT signing secret — server won't start without it
# Generate: openssl rand -hex 32
JWT_SECRET=""

# ── Admin ────────────────────────────────────────────────────
# Master admin credentials (created on first startup if both set)
# MASTER_ADMIN_EMAIL="admin@turbopay.ng"
# MASTER_ADMIN_PASSWORD=""

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = wildcard in sandbox)
# CORS_ALLOWED_ORIGINS="https://turbopay.ng,https://app.turbopay.ng"

# ── Rate Limiting ────────────────────────────────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10

# ── TLS (optional) ──────────────────────────────────────────
# Paths to TLS certificate and key files for HTTPS
# SSL_CERT_PATH=""
# SSL_KEY_PATH=""

# ── Persistence ──────────────────────────────────────────────
# Directory for JSON file persistence (default: ./data)
# DATA_DIR=./data

# ── Application ──────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=sandbox

# ── Payment Providers ────────────────────────────────────────
# Paystack
# PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_WEBHOOK_SECRET=""

# Flutterwave v4
# FLUTTERWAVE_CLIENT_ID=""
# FLUTTERWAVE_CLIENT_SECRET=""
# FLUTTERWAVE_ENCRYPTION_KEY=""
# FLUTTERWAVE_PUBLIC_KEY=""
# FLUTTERWAVE_WEBHOOK_SECRET=""

# Flutterwave v3 (splits/chargebacks)
# FLUTTERWAVE_V3_SECRET_KEY=""
# FLUTTERWAVE_V3_PUBLIC_KEY=""
# FLUTTERWAVE_V3_WEBHOOK_SECRET=""

# Monnify
# MONNIFY_API_KEY=""
# MONNIFY_API_SECRET=""
# MONNIFY_CONTRACT_CODE=""
# MONNIFY_WEBHOOK_SECRET=""

# Onafriq
# ONAFRIQ_CLIENT_ID=""
# ONAFRIQ_CLIENT_SECRET=""
# ONAFRIQ_API_KEY=""
# ONAFRIQ_WEBHOOK_SECRET=""

# Remita
# REMITA_API_KEY=""
# REMITA_API_SECRET=""
# REMITA_MERCHANT_ID=""
# REMITA_WEBHOOK_SECRET=""

# Quickteller
# QUICKTELLER_CLIENT_ID=""
# QUICKTELLER_CLIENT_SECRET=""
# QUICKTELLER_MERCHANT_CODE=""
# QUICKTELLER_TERMINAL_ID=""
# QUICKTELLER_WEBHOOK_SECRET=""

# ── Mobile Money Providers ──────────────────────────────────
# Smart Cash (Nigeria)
# SMARTCASH_CLIENT_ID=""
# SMARTCASH_CLIENT_SECRET=""
# SMARTCASH_SHORTCODE=""
# SMARTCASH_WEBHOOK_SECRET=""

# Airtel Money (Multi-country, excludes Nigeria)
# AIRTEL_MONEY_CLIENT_ID=""
# AIRTEL_MONEY_CLIENT_SECRET=""
# AIRTEL_MONEY_API_KEY=""
# AIRTEL_MONEY_WEBHOOK_SECRET=""

# MTN MoMo (Multi-country, includes Nigeria)
# MTN_MOMO_API_KEY=""
# MTN_MOMO_API_SECRET=""
# MTN_MOMO_SUBSCRIPTION_KEY=""
# MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=""
# MTN_MOMO_API_USER=""
# MTN_MOMO_CALLBACK_URL=""
# MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

# M-Pesa (Kenya primarily)
# MPESA_CONSUMER_KEY=""
# MPESA_CONSUMER_SECRET=""
# MPESA_SHORTCODE=""
# MPESA_PASSKEY=""
# MPESA_CALLBACK_URL=""
# MPESA_INITIATOR_NAME=""
# MPESA_SECURITY_CREDENTIAL=""

# Paga (Nigeria)
# PAGA_PRINCIPAL=""
# PAGA_CREDENTIALS=""
# PAGA_HASH_KEY=""
# PAGA_API_KEY=""

# ── OTP Service ─────────────────────────────────────────────
# OTP_API_KEY=""
# OTP_SENDER_ID=""
