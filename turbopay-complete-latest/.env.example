# =============================================================================
# TurboPay Next.js App — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel/Render), set these via the platform's environment
# variable UI. Never commit .env.local.
# =============================================================================

# ─── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev, use SQLite:
#   file:./dev.db
DATABASE_URL="postgresql://user:password@localhost:5432/turbopay"

# ─── PII Encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting sensitive data (BVN, NIN, bank details).
# Generate with: openssl rand -base64 32
TURBOPAY_PII_KEY="your-32-byte-base64-encoded-key-here"

# ─── Monnify ─────────────────────────────────────────────────────────────────
# Webhook secret for verifying Monnify funding webhooks (prevents forgery).
# Required in production.
TURBOPAY_MONNIFY_WEBHOOK_SECRET="monnify-webhook-secret-here"

# Monnify API credentials (for BVN/NIN verification and virtual accounts).
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

# ─── Redis ───────────────────────────────────────────────────────────────────
# Required in production for distributed rate limiting, sessions, and caching.
# Without Redis, rate limits are per-instance and can be bypassed.
REDIS_URL="redis://localhost:6379"

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
# Secret for authenticating cron job invocations.
# Required in staging/production. Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ─── Notifications ───────────────────────────────────────────────────────────
# Termii (SMS) — optional until integrated.
TERMII_API_KEY=""
TERMII_SENDER_ID="Turbopay"

# Resend (email) — optional until integrated.
RESEND_API_KEY=""

# ─── Provider Credentials ────────────────────────────────────────────────────
# Baxi (bills payment)
BAXI_API_KEY=""

# Dojah (KYC/identity verification)
DOJAH_APP_ID=""
DOJAH_PUBLIC_KEY=""
DOJAH_PRIVATE_KEY=""

# ─── Webhook Secrets ─────────────────────────────────────────────────────────
# Each provider's webhook handler checks its own secret.
# If the secret is missing, webhooks will be rejected (401).
FLUTTERWAVE_WEBHOOK_SECRET=""
WISE_WEBHOOK_SECRET=""
STRIPE_ISSUING_WEBHOOK_SECRET=""
RESEND_WEBHOOK_SECRET=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL for generating payment links, OAuth callbacks, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth secret for session management.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ─── Development ─────────────────────────────────────────────────────────────
# Set to "development" for local dev, "production" for deployment.
NODE_ENV="development"
