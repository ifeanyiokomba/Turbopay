# ============================================================
# TurboPay Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection URL (pooled, for runtime)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct URL for Prisma migrations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Redis ────────────────────────────────────────────────────
# Shared cache, rate limiting, circuit breaker, sessions.
# Required for multi-instance deployments.
REDIS_URL="redis://:password@localhost:6379"

# ── Security Keys ────────────────────────────────────────────
# JWT signing secret (REQUIRED — server won't start without it)
# Generate: openssl rand -hex 32
JWT_SECRET=""

# AES-256-GCM key for PII encryption (>= 16 chars, or 64-char hex).
# Generate: openssl rand -hex 32
TURBOPAY_PII_KEY=""

# HMAC secret for Monnify webhook signature verification.
# Generate: openssl rand -hex 32
TURBOPAY_MONNIFY_WEBHOOK_SECRET=""

# Secret for authenticating cron job requests (x-cron-secret header).
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ── Admin ────────────────────────────────────────────────────
# Master admin credentials (created on first startup if both set)
# MASTER_ADMIN_EMAIL="admin@turbopay.ng"
# MASTER_ADMIN_PASSWORD=""

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = wildcard in sandbox, blocked in production)
# CORS_ALLOWED_ORIGINS="https://turbopay.ng,https://app.turbopay.ng"

# ── Rate Limiting ────────────────────────────────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10

# ── TLS (optional) ──────────────────────────────────────────
# Paths to TLS certificate and key files for HTTPS
# SSL_CERT_PATH=""
# SSL_KEY_PATH=""

# ── Application ──────────────────────────────────────────────
# Public URL of the application (used for CSRF origin validation).
NEXT_PUBLIC_APP_URL="https://turbopay.example.com"
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# ── Payment Providers ────────────────────────────────────────
# Paystack
# PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_WEBHOOK_SECRET=""

# Flutterwave v4
# FLUTTERWAVE_CLIENT_ID=""
# FLUTTERWAVE_CLIENT_SECRET=""
# FLUTTERWAVE_ENCRYPTION_KEY=""
# FLUTTERWAVE_PUBLIC_KEY=""
# FLUTTERWAVE_WEBHOOK_SECRET=""

# Flutterwave v3 (splits/chargebacks)
# FLUTTERWAVE_V3_SECRET_KEY=""
# FLUTTERWAVE_V3_PUBLIC_KEY=""
# FLUTTERWAVE_V3_WEBHOOK_SECRET=""

# Monnify
# MONNIFY_API_KEY=""
# MONNIFY_API_SECRET=""
# MONNIFY_CONTRACT_CODE=""
# MONNIFY_WEBHOOK_SECRET=""

# Onafriq
# ONAFRIQ_CLIENT_ID=""
# ONAFRIQ_CLIENT_SECRET=""
# ONAFRIQ_API_KEY=""
# ONAFRIQ_WEBHOOK_SECRET=""

# Remita
# REMITA_API_KEY=""
# REMITA_API_SECRET=""
# REMITA_MERCHANT_ID=""
# REMITA_WEBHOOK_SECRET=""

# Quickteller
# QUICKTELLER_CLIENT_ID=""
# QUICKTELLER_CLIENT_SECRET=""
# QUICKTELLER_MERCHANT_CODE=""
# QUICKTELLER_TERMINAL_ID=""
# QUICKTELLER_WEBHOOK_SECRET=""

# ── Notification Providers ──────────────────────────────────
# Notification providers (email/SMS) are configured via the Admin Console
# (Platform Settings → Provider Credentials), NOT via environment variables.
#
# Supported providers:
#   EMAIL: Resend (recommended), Gmail SMTP, Termii
#   SMS: GetOTP/otp.dev (recommended), Termii
#
# To configure:
#   1. Go to Admin Console → Platform Settings → Provider Credentials
#   2. Add a new provider (e.g., "resend" for email, "termii" for SMS)
#   3. Enter the API credentials (encrypted at rest)
#   4. Set mode to "production" and enable the provider
#
# Required for: OTP delivery, transaction SMS alerts, password reset emails,
# KYC notifications, new device alerts.
#
# Without configured providers, OTP codes are logged to console in dev mode
# but never delivered in production.

# ── OAuth (optional) ────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# NEXT_PUBLIC_APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""

# ── WebAuthn (optional) ─────────────────────────────────────
# WEBAUTHN_RP_ID="turbopay.example.com"
# WEBAUTHN_ORIGIN="https://turbopay.example.com"

# ── Error Tracking (optional) ───────────────────────────────
# SENTRY_ORG=""
# SENTRY_PROJECT="turbopay"

# ── IP Allow/Block Lists (optional) ─────────────────────────
# Comma-separated IPs for admin access bypass.
# ALLOWED_IPS=""
# Comma-separated IPs to reject.
# BLOCKED_IPS=""

# ── Maintenance Mode (optional) ─────────────────────────────
# MAINTENANCE_MODE="false"
