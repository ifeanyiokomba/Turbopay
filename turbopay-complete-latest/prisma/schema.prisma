  @@index([conversationId, createdAt])
}

/// A device a user has signed in from. Used for device recognition,
/// trusted-device management, and the Security Center timeline.
model Device {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String   // sha256(UA + /24 IP subnet) — stable per device+network
  deviceName   String   // parsed from UA, e.g. "Chrome on macOS"
  ip           String?
  trusted      Boolean  @default(false)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

