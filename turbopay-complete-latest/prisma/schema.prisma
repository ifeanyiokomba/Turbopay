  sourceTransactionId   String?  // for CASHBACK: the Transaction that earned it
  ruleId                String?  // for CASHBACK: the RewardRule id used (future)
  tier                  Int?     // for TIER_BONUS: the KYC tier that earned the bonus
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@index([sourceTransactionId, type])
  @@index([userId, type, tier])
}

/// Virtual card transaction — spending on the card.
model VirtualCardTransaction {
  id              String   @id @default(cuid())
  cardId          String
  card            VirtualCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
