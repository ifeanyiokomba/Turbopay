/// Unified security event for the Security Center timeline.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // LOGIN_SUCCESS | LOGIN_FAILED | DEVICE_NEW | DEVICE_RECOGNIZED | SESSION_REVOKED | PIN_CHANGED | PASSWORD_CHANGED | STEP_UP_REQUIRED | STEP_UP_PASSED | STEP_UP_FAILED
  ip        String?
  userAgent String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Optional security question for secondary verification.
model SecurityQuestion {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answerHash String   // sha256 of normalised answer
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// User testimonial — displayed on the landing page. Managed by admins.
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   // e.g. "Student", "Small business owner"
  location  String?  // e.g. "Lagos"
  quote     String
  rating    Int      @default(5) // 1-5 stars
  avatarUrl String?
  approved  Boolean  @default(false) // only approved testimonials show on the landing page
  display   Boolean  @default(true)  // admin can hide without deleting
  sortOrder Int      @default(100)   // lower = earlier in the list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, display, sortOrder])
}

/// Transactional Outbox Event — written INSIDE the same Prisma tx as the
/// domain state change (ledger post, transaction status flip, etc.) so the
/// event is guaranteed to be published if and only if the tx commits.
///
/// A cron worker (`/api/cron/outbox-publisher`) drains PENDING rows and
/// publishes each via the TurboCore event bus. Failed publishes are marked
/// FAILED (retried manually or by a future sweep).
///
/// This eliminates the dual-write problem: previously the pipeline published
/// `payment.succeeded` via the in-process event bus AFTER the tx committed —
/// if the process crashed between commit and publish, the event was lost.
/// With the outbox, the event row commits atomically with the state change,
/// so the worker will pick it up on the next tick.
model OutboxEvent {
  id            String    @id @default(cuid())
  /// Coarse aggregate type — "transaction" | "wallet" | "kyc" | "card" | …
  aggregateType String
  /// The entity ID the event refers to (transactionId / walletId / userId / …).
  aggregateId   String
  /// Dotted event type — "payment.succeeded" | "wallet.funded" | "kyc.verified" | …
  eventType     String
  /// JSON-stringified event payload (read by the outbox publisher).
  payload       String
  /// PENDING → PUBLISHED (ok) | FAILED (dead-letter after retries).
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
}

/// Payment Intent — separates "intent to pay" from "execution of payment".
///
/// The Turbopay reference document separates these two phases so the client
/// can poll a payment's lifecycle independently of the financial transaction
/// record (Transaction). The debit pipeline creates a PaymentIntent at the
/// START (status=PENDING), marks it PROCESSING before the hold, SUCCEEDED on
/// success, or FAILED on failure.
///
/// This is non-breaking: the existing flow continues to work, the intent is
/// just an additional record that tracks the lifecycle. It enables:
///   - Status polling (client checks if a payment is still processing)
///   - Intent cancellation (user cancels a PENDING intent before execution)
///   - Analytics (intent → execution → success/failure funnel)
model PaymentIntent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // AIRTIME | DATA | BILL_ELECTRICITY | BILL_UTILITY | TRANSFER | CARD_FUND
  amountKobo  Int
  currency    String   @default("NGN")
  status      String   @default("PENDING") // PENDING | PROCESSING | SUCCEEDED | FAILED | CANCELLED
  recipient   String?  // phone, account number, or meter number
  metadata    String?  // JSON
  idempotencyKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([idempotencyKey])
}

/// Settlement Queue — failed external transfers awaiting retry.
///
/// When an external bank transfer fails transiently (5xx, timeout, network
/// error) or the orchestrator crashes after the provider returned a reference
/// but before the confirm step committed, the transaction is enqueued here for
/// the settlement worker to reconcile.
///
/// The `/api/cron/settlement-worker` route polls the queue every 5 minutes
/// and calls `settlementService.processBatch()`:
///   • If a `providerRef` exists → query the provider for the transfer status
///     (SUCCESS → confirm the Transaction + mark SETTLED; FAILED → reverse
///     the ledger entry + mark FAILED; PENDING → retry with exponential
///     backoff).
///   • If no `providerRef` (provider call never completed) → increment the
///     attempt counter with backoff. After `maxAttempts`, mark FAILED. The
///     stuck-transaction sweeper handles the actual ledger reversal for the
///     no-providerRef case (it is the authoritative path for that scenario —
///     see `/api/cron/stuck-transactions`).
///
/// The queue is an ADDITIONAL safety net layered on top of the existing
/// stuck-transaction sweeper. The sweeper still catches PENDING rows that
/// have aged past the SLA window; when it sees a stuck row WITH a providerRef
/// it now ENQUEUES it here (instead of just auditing CRITICAL) so the
/// settlement worker can run the provider status check on the next tick.
model SettlementQueue {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  providerRef     String?
  status          String   @default("PENDING") // PENDING | PROCESSING | SETTLED | FAILED | RETRYING
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  nextRetryAt     DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, nextRetryAt])
}

/// Cron leader-election lock — ensures only ONE instance runs each cron job
/// at a time, even with multiple app instances behind a load balancer.
/// The cron route calls `acquireCronLock(name)` at the start; if it returns
/// false, another instance is already running this cron, so it exits early.
/// On completion (or crash after TTL expiry), the lock is released.
model CronLock {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "outbox-publisher", "stuck-transactions"
  lockedBy    String?  // instance ID (hostname + PID)
  lockedAt    DateTime?
  expiresAt   DateTime? // TTL — auto-released after this time even if the process crashes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Multi-currency wallet — each user can hold balances in multiple currencies.
/// The primary NGN wallet (Wallet model) remains the main wallet for backward
/// compatibility. CurrencyWallet adds USD, EUR, GBP, CAD, AUD, KES, GHS, ZAR.
model CurrencyWallet {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency      String   // USD | EUR | GBP | CAD | AUD | KES | GHS | ZAR
  balanceMinor  Int      @default(0) // cache; recomputed from ledger
  lockedMinor   Int      @default(0) // amount locked in pending transfers
  status        String   @default("ACTIVE") // ACTIVE | FROZEN | CLOSED
  version       Int      @default(0) // optimistic concurrency
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgerEntries  CurrencyLedgerEntry[]

  @@unique([userId, currency])
  @@index([userId])
  @@index([status])
}

/// International beneficiary — saved recipients for cross-border transfers.
model InternationalBeneficiary {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  country         String   // 2-letter ISO code
  bankName        String?
  accountNumber   String?  // account number or IBAN
  swiftCode       String?  // SWIFT/BIC code
  routingNumber   String?  // routing number (US/CA)
  mobileWallet    String?  // mobile money provider + number
  nickname        String?
  currency        String   // preferred currency for this beneficiary
  isFavourite     Boolean  @default(false)
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED | VERIFIED | FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userId, isFavourite])
}

/// System-wide singleton for cached aggregate values (total float, total
/// users, etc.) that are too expensive to compute on every admin request.
/// Updated by a periodic refresh job, read by admin dashboards.
model SystemMetric {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "total_float_kobo", "active_users"
  value       String   // stored as string, parsed by caller
  updatedAt   DateTime @updatedAt
}

// ============================================================
// PAYMENT ORCHESTRATION MODELS
// ============================================================

/// Payment Flow Execution Log — records every payment orchestration attempt.
/// Stores routing decisions, provider responses, failover attempts, and timing.
/// Used for audit trail, analytics, and debugging payment flows.
model PaymentFlowLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference       String   @unique // Payment reference (TP-XXXXXXXX)
  contract        String   // walletFunding | localTransfer | billPayment | exchangeRate
  amountKobo      Int
  currency        String   @default("NGN")
  country         String?
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED | TIMEOUT
  // Routing decision details
  selectedProvider    String?  // Provider that was selected
  selectionReason     String?  // Why this provider was selected
  selectionScore      Int?     // Routing score (0-100)
  candidatesCount     Int?     // Total candidates considered
  attemptsCount       Int?     // Number of providers attempted
  // Provider response
  providerRef         String?  // Provider's transaction reference
  providerStatus      String?  // Provider's response status
  providerError       String?  // Provider's error message (if failed)
  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?     // Total execution time in milliseconds
  // Metadata
  metadata        String?  // JSON string for additional context
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contract, status, createdAt])
  @@index([selectedProvider, status])
  @@index([createdAt])
}

/// Provider Capability Declaration — DB-driven capability matrix.
/// Stores which capabilities each provider supports. Can be used instead of
/// (or in addition to) code-driven capabilities for dynamic configuration.
model ProviderCapability {
  id              String   @id @default(cuid())
  providerName    String
  capability      String   // collection | transfer | bill_payment | airtime | data | fx | ...
  supported       Boolean  @default(true)
  // Which countries/currencies this capability supports (JSON arrays)
  supportedCountries String? // JSON string[]
  supportedCurrencies String? // JSON string[]
  // Cost profile for this capability
  percentageFeeBps Int     @default(0)
  fixedFeeMinor   Int      @default(0)
  // Rate limits
  requestsPerMinute Int?
  maxTransferAmount Int?
  // Metadata
  version         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerName, capability])
  @@index([providerName])
  @@index([capability])
}

/// Payment Routing Decision Log — stores every routing decision for analytics.
/// Used to analyze provider selection patterns, identify bottlenecks, and
/// optimize routing rules.
model PaymentRoutingDecision {
  id              String   @id @default(cuid())
  userId          String?
  contract        String
  amountKobo      Int
  currency        String
  country         String?
  // Decision details
  selectedProvider    String
  selectionReason     String
  selectionScore      Int
  candidatesCount     Int
  eliminatedCount     Int
  // Factor scores (JSON)
  factorScores        String?  // JSON: { health: 95, latency: 80, cost: 70, ... }
  // Timing
  decisionMs      Int      // Time taken to make the decision (ms)
  createdAt       DateTime @default(now())

  @@index([contract, createdAt])
  @@index([selectedProvider, createdAt])
  @@index([createdAt])
}

// ============================================================
// PAYMENT LINKS — Generate shareable payment links for customers
// ============================================================

model PaymentLink {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link details
  reference       String   @unique // PL-XXXXXXXX (unique link reference)
  title           String   // Display title (e.g. "Payment for Invoice #123")
  description     String?  // Optional description
  amountKobo      Int      // Amount in kobo (0 = user enters amount)
  currency        String   @default("NGN")

  // Configuration
  allowCustomAmount Boolean @default(false) // User can enter their own amount
  minAmountKobo   Int?     // Minimum amount (if custom allowed)
  maxAmountKobo   Int?     // Maximum amount (if custom allowed)
  maxUses         Int?     // Maximum number of times link can be used (null = unlimited)
  useCount        Int      @default(0) // Times link has been used
  expiresAt       DateTime? // Link expiry (null = never expires)

  // Status
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | EXPIRED | DEACTIVATED

  // Metadata
  metadata        String?  // JSON string for custom data

  // Provider reference (if linked to a specific provider payment)
  providerRef     String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Payments made via this link
  payments        PaymentLinkPayment[]

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model PaymentLinkPayment {
  id              String   @id @default(cuid())
  paymentLinkId   String
  paymentLink     PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)

  // Payment details
  reference       String   @unique // TP-XXXXXXXX (transaction reference)
  amountKobo      Int
  feeKobo         Int      @default(0)
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED
  payerEmail      String?
  payerName       String?

  // Provider reference
  provider        String?
  providerRef     String?

  createdAt       DateTime @default(now())

  @@index([paymentLinkId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}
