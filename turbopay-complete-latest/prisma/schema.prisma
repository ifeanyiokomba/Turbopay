/// Dispute — user-reported issue with a transaction (failed transfer, incorrect debit, card dispute, bill issue).
model Dispute {
  id              String   @id @default(cuid())
  disputeNumber   String   @unique // DSP-2026-000123
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId   String?  // the disputed transaction (if applicable)
  type            String   // FAILED_TRANSFER | INCORRECT_DEBIT | CARD_DISPUTE | BILL_PAYMENT_ISSUE | UNAUTHORIZED_TRANSACTION | DUPLICATE_CHARGE | OTHER
  priority        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status          String   @default("OPEN") // OPEN | UNDER_REVIEW | EVIDENCE_REQUIRED | RESOLVED_FAVOUR_USER | RESOLVED_FAVOUR_PLATFORM | CLOSED | ESCALATED
  subject         String
  description     String
  amountDisputedKobo Int?
  resolution      String?
  resolutionNotes String?
  assignedTo      String?  // admin userId
  slaDueAt        DateTime? // SLA deadline
  metadata        String?  // JSON — evidence, provider refs, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?

  messages        DisputeMessage[]
  attachments     DisputeAttachment[]

  @@index([userId, status])
  @@index([status, priority])
  @@index([assignedTo])
  @@index([createdAt])
}

/// Dispute message — communication within a dispute.
model DisputeMessage {
  id              String   @id @default(cuid())
  disputeId       String
  dispute         Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId        String?
  authorName      String
  authorRole      String   @default("CUSTOMER") // CUSTOMER | AGENT | SYSTEM
  message         String
  isInternal      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([disputeId, createdAt])
}

/// Dispute attachment — evidence files.
model DisputeAttachment {
  id              String   @id @default(cuid())
  disputeId       String
  dispute         Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fileName        String
  filePath        String
  fileType        String
  fileSizeBytes   Int
  uploadedBy      String
  createdAt       DateTime @default(now())

  @@index([disputeId])
}

/// Scheduled payment — recurring or future-dated transfers/bill payments.
model ScheduledPayment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // TRANSFER | BILL_PAYMENT | AIRTIME | DATA
  frequency       String   // ONCE | DAILY | WEEKLY | MONTHLY | CUSTOM
  nextExecutionAt DateTime
  endDate         DateTime? // null = until cancelled
  customDates     String?  // JSON array of ISO dates for CUSTOM frequency
  // Payment details
  recipient       String   // account number, phone, or biller customer ref
